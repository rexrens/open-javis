    "ui-plan",
    "ui-message-feedback",
    "ui-agent-preset",
    "ui-skill",
    "ui-subagent",
    "ui-reference",
    "ui-workflow-run",
    "ui-deliverables",
    "ui-cordis",
    "ui-attachment",
    "ui-open-in-app",
